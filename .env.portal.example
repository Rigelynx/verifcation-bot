# Añade estas variables a HolyHosting junto con las de .env.discord.example.
# El ID de usuario de Discord se obtiene con Modo desarrollador > Copiar ID.
# Solo estos usuarios pueden consultar la consola /owner. Sin lista, acceso cerrado.
BOT_OWNER_IDS=TU_ID_DE_USUARIO_DISCORD
# Opcional: varios propietarios separados por comas. Nunca usar IDs de rol aquí.
BOT_PUBLIC_NAME=RICO
