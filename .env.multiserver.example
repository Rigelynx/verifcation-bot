# Conserva el GUILD_ID que ya identifica tus datos antiguos de USMC.
# No lo cambies por UKAF: los servidores nuevos se detectan automáticamente.
GUILD_ID=ID_DEL_SERVIDOR_ORIGINAL
BOT_OWNER_IDS=TU_ID_PERSONAL_DISCORD
BOT_PUBLIC_NAME=RICO

# Producción: catálogo común en todos los servidores.
COMMAND_SCOPE=global
# Para probar exclusivamente en un servidor:
# COMMAND_SCOPE=guild
# COMMAND_TEST_GUILD_ID=ID_DEL_SERVIDOR_DE_PRUEBAS

# El respaldo diario incluye SQLite y la carpeta de imágenes por servidor.
# 0 desactiva la programación. También existe npm run backup.
BACKUP_INTERVAL_HOURS=24

# Opcional. Solo establecer tras copiar/restaurar la base existente a esa ruta.
# Si ya existe database.sqlite en la raíz, se conserva su ubicación por defecto.
# DB_PATH=./data/database.sqlite

# Opcional: enlace HTTPS del servidor o formulario de soporte del propietario.
# SUPPORT_URL=https://discord.gg/TU_INVITACION

# OAuth utiliza CLIENT_ID, DISCORD_CLIENT_SECRET y WEB_URL como hasta ahora.
# La IA sigue necesitando ASSISTANT_ENABLED=true y DEEPSEEK_API_KEY.
# Habilita después cada comunidad y sus usuarios desde /owner.
