# Asistente exclusivo con DeepSeek de pago. Clave solo en el host o .env local.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=deepseek
# Vacío usa deepseek-flash; también puede indicarse el nombre del modelo directo.
ASSISTANT_MODEL=
DEEPSEEK_API_KEY=
ASSISTANT_MAX_OUTPUT_TOKENS=1536
ASSISTANT_REQUEST_TIMEOUT_SECONDS=90
ASSISTANT_TOTAL_TIMEOUT_SECONDS=180

# Máximo 10 IDs. Vacío: solo el propietario del servidor.
ASSISTANT_ALLOWED_IDS=
# 0 = sin cupo diario impuesto por el bot; los límites del proveedor siguen aplicando.
ASSISTANT_DAILY_LIMIT=0

# Configura también CLIENT_ID, DISCORD_CLIENT_SECRET, GUILD_ID y WEB_URL.
