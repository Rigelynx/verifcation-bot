# Añadir en el panel de variables de HolyHosting o en .env, nunca en el chat.
CLIENT_ID=ID_DE_LA_APLICACION_DISCORD
DISCORD_CLIENT_SECRET=SECRETO_OAUTH2_DE_LA_APLICACION
GUILD_ID=ID_DEL_SERVIDOR_DISCORD
WEB_URL=https://tu-dominio-publico

# Opcional: habilita expresamente el acceso anterior como recuperación.
# El inicio anterior queda deshabilitado por defecto al completar OAuth2.
ADMIN_LEGACY_LOGIN=false
